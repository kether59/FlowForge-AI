# =====================================================================
# FlowForge AI — variables d'environnement
# Copiez ce fichier en `.env` puis renseignez les clés utiles.
# Sans clé, l'application fonctionne en mode démo (provider "mock").
# =====================================================================

APP_NAME="FlowForge AI"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Provider LLM par défaut -----------------------------------------
# mock | openai | openrouter | vertex | ollama | vllm
DEFAULT_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vertex AI / Gemini (clé API Generative Language)
VERTEX_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# Modèles locaux
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1

# --- Embeddings -------------------------------------------------------
# mock (hashing local, hors ligne) | openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# --- Connecteurs ------------------------------------------------------
# Chemin vers le JSON d'un service account Google (Drive readonly)
GOOGLE_DRIVE_CREDENTIALS=
# Confluence Atlassian (Basic auth : email + API token)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# --- Moteur -----------------------------------------------------------
CODE_NODE_TIMEOUT=10
MAX_PARALLEL_NODES=8
MAX_UPLOAD_SIZE_MB=100
